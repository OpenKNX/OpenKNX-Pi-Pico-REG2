  )
  (text "When Using the OpenKNX Progger Interface \n(USB, Debug and Progger) be sure that \nyou set the Jumper JP5 to use the 3V3.\n\nNotice - If this option is used: \nJP1, JP2, JP3 or JP4 has not effekt."
    (at 479.806 59.69 0)
    (effects (font (size 1.27 1.27) (thickness 0.254) bold) (justify left bottom))
    (uuid 81a98fbc-cfe1-43ec-8e26-9ebf6b1fdafd)
  )
  (text "JP5:1+2" (at 479.552 43.688 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
